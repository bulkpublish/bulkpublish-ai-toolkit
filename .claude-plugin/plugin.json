{
  "name": "bulkpublish",
  "version": "1.11.0",
  "description": "Social media automation toolkit — schedule posts, manage channels, track analytics across 15 platforms via MCP",
  "author": {
    "name": "BulkPublish",
    "email": "support@bulkpublish.com",
    "url": "https://bulkpublish.com"
  },
  "homepage": "https://bulkpublish.com",
  "repository": "https://github.com/bulkpublish/bulkpublish-ai-toolkit",
  "license": "MIT",
  "keywords": [
    "social-media",
    "automation",
    "scheduling",
    "analytics",
    "mcp",
    "publishing"
  ],
  "mcpServers": {
    "bulkpublish": {
      "command": "npx",
      "args": [
        "-y",
        "@bulkpublish/mcp-server@1.33.2"
      ],
      "env": {
        "BULKPUBLISH_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "BulkPublish API key",
      "description": "Your BulkPublish API key (starts with bp_). Create one at https://app.bulkpublish.com/developer",
      "sensitive": true,
      "required": true
    }
  }
}
